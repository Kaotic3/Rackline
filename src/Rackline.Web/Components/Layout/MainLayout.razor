@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/">Rackline</a>
    <nav>
        <a href="/tournaments">Tournaments</a>
        <a href="/leagues">Leagues</a>
        <a href="/players">Players</a>
        <a href="/rankings">Rankings</a>
        <a href="/ratings">Ratings</a>
        <a href="/organisations">Organisations</a>
        <AuthorizeView Policy="@Policies.ScoreMatches">
            <a href="/referee">Scoring</a>
            <a href="/organiser">Your organisations</a>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <span class="who">@context.User.Identity?.Name</span>
                <form method="post" action="/account/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/account/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
