<!DOCTYPE html>
<html lang="en-GB" class="@(IsOverlay ? "overlay" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Rackline.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/signalr/signalr.min.js"]"></script>
    <script src="@Assets["js/live.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>Overlay pages are shown over video, so the page itself must be see-through.</summary>
    private bool IsOverlay => HttpContext?.Request.Path.StartsWithSegments("/overlay") == true;
}
