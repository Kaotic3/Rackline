@page "/"

<PageTitle>Rackline</PageTitle>

<h1>Rackline</h1>

<p class="lead">Tournaments, live scoring and results for cue sports, with no adverts.</p>

<AuthorizeView Policy="@Policies.ScoreMatches">
    <Authorized>
        <p><a class="button" href="/referee">Go to scoring</a></p>
    </Authorized>
    <NotAuthorized>
        <p>Referees and organisers can <a href="/account/login">sign in</a> to score matches.</p>
    </NotAuthorized>
</AuthorizeView>
