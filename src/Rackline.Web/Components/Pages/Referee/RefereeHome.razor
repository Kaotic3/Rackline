@page "/referee"
@attribute [Authorize(Policy = Policies.ScoreMatches)]
@inject ITournamentQueries Queries
@inject OrganisationAccess Access

<PageTitle>Scoring · Rackline</PageTitle>

<h1>Scoring</h1>

<p><a class="button secondary" href="/referee/challenges/new">Record a challenge</a></p>

@if (_tournaments is null)
{
    <p>Loading…</p>
}
else if (_tournaments.Count == 0)
{
    <p class="notice">None of the tournaments you can score is in progress.</p>
}
else
{
    <p>Choose a tournament to see its matches.</p>
    <ul class="cards">
        @foreach (var tournament in _tournaments)
        {
            <li>
                <a href="/referee/tournaments/@tournament.Id">
                    <strong>@tournament.Name</strong>
                    <span class="muted">@tournament.EntryCount entries</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<TournamentSummaryDto>? _tournaments;

    protected override async Task OnInitializedAsync()
    {
        var scorable = new List<TournamentSummaryDto>();
        foreach (var tournament in await Queries.ListAsync(TournamentStatus.InProgress, CancellationToken.None))
        {
            if (await Access.CanAsync(tournament.OrganisationId, StaffRole.Referee, CancellationToken.None))
            {
                scorable.Add(tournament);
            }
        }

        _tournaments = scorable;
    }
}
